# Kopieren nach .env und ausfüllen. Die .env wird nicht eingecheckt.

# Passwort des MongoDB-Root-Users (docker-compose und Backend)
MONGO_ROOT_PASSWORD=change-me
# Optional: komplette Verbindungs-URL statt MONGO_ROOT_PASSWORD
# MONGO_URL=mongodb://root:change-me@localhost:27017/

# Milvus (Standardwerte passen zum mitgelieferten docker-compose)
# MILVUS_HOST=localhost
# MILVUS_PORT=19530

# Redis-Cache (optional, ohne Redis läuft die API weiter)
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=300

# NewsAPI (optional; ohne Key werden nur RSS-Feeds importiert)
NEWSAPI_KEY=
